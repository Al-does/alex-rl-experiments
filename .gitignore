.venv/
*.egg-info/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Large/raw experiment outputs. Compact leaf results/ remain trackable.
experiments/**/artifacts/
# Throwaway manifests, summaries, and artifacts from --smoke runs.
experiments/**/.smoke/

# Full B2 file indexes; use run_manifest.json -> remote_artifacts instead.
experiments/**/results/**/remote_artifacts.json
experiments/**/results/**/durability_manifest.json

# Local secrets (B2 keys, etc.)
.env.local

# Cached Cloud Agent transcripts (may contain prompts/secrets)
.cursor/cloud-transcripts/
