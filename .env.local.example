# Copy to ~/.rl_harness_b2_env (recommended) or .env.local in this repo.
# Never commit real secrets.
#
# Quick setup:
#   ./scripts/setup_b2_env.sh
#
# Cursor Cloud Agents: add the same four variables as Runtime Secrets in the
# dashboard (B2_APPLICATION_KEY must be Runtime Secret).

export B2_BUCKET="your-bucket-name"
export B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
export B2_APPLICATION_KEY_ID="004..."
export B2_APPLICATION_KEY="K004..."
# Optional namespace inside the bucket:
export B2_PREFIX="alex"
