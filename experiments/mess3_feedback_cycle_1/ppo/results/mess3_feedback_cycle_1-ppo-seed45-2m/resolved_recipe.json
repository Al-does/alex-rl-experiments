{
  "algorithm": "PPO",
  "causal_evaluations": [
    "closed_loop_previous_action_mask_and_shuffle",
    "counterfactual_previous_action_belief_shift"
  ],
  "checkpoint_frequency_iterations": 10,
  "condition": "ppo_feedback_eta_0p10",
  "environment": {
    "delay": 1,
    "episode_length": 512,
    "model": {
      "factory": "envs.mess3.model:passive_model",
      "kwargs": {
        "alpha": 0.85
      }
    },
    "observation": {
      "action": {
        "depth": 1,
        "offset": 0
      },
      "token": {
        "depth": 1,
        "offset": 0
      }
    },
    "randomize_first_episode_length": true,
    "task": {
      "class": "experiments.mess3_feedback_cycle_1.task:FeedbackNextTokenTask",
      "kwargs": {
        "eta": 0.1
      }
    }
  },
  "eta": 0.1,
  "feedback_transition": "U_a = (1 - eta) * T + eta * R_a; R_a sends every state to a",
  "gamma": 0.0,
  "lambda": 0.0,
  "lr": 0.0001,
  "minibatch_size": 4096,
  "model": {
    "activation": "relu",
    "context_length": 10,
    "d_head": 8,
    "d_mlp": 256,
    "d_model": 64,
    "max_seq_len": 32,
    "n_heads": 1,
    "n_layers": 4,
    "normalization": "layer_norm",
    "positional_embedding": "learned_absolute"
  },
  "num_epochs": 6,
  "objective": "clipped_next_token_correctness",
  "study": "mess3_feedback_cycle_1",
  "total_env_steps": 2000000,
  "train_batch_size_per_learner": 32768,
  "vf_loss_coeff": 0.5
}
