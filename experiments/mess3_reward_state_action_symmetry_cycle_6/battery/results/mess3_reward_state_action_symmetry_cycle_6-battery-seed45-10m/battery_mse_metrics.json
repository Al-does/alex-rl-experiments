  "metric_definitions": {
    "branch_baseline_mse": "mean((exact_belief - branch_centroid)^2)",
    "fine_evaluation_mse": "probe MSE restricted to evaluated token branches",
    "fine_mse_improvement": "branch_baseline_mse - fine_evaluation_mse",
    "fine_mse_ratio": "fine_evaluation_mse / branch_baseline_mse",
    "global_mse_ratio": "mse / target_variance",
    "mse": "mean((decoded_belief - exact_belief)^2)",
    "target_variance": "mean((exact_belief - global_mean_belief)^2)"
  },
