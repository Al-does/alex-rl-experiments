            }
          },
          {
            "factory": "envs.mess3.model:passive_model",
            "kwargs": {
              "alpha": 0.85
            }
          },
          {
            "factory": "envs.mess3.model:passive_model",
            "kwargs": {
              "alpha": 0.85
            }
          }
        ]
      }
    },
    "observation": {
      "action": null,
      "token": {
        "depth": 1,
        "offset": 0
      }
    },
