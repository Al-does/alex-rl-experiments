{
  "action_semantics": "two categorical action logits, one per Wing token",
  "algorithm": "clipped PPO",
  "analysis": "held-out layerwise affine probes of the exact delayed Wing belief",
  "changes_from_cycle_1": {
    "hidden_state_count": {
      "after": 3,
      "before": 9
    },
    "model": {
      "after": "one primitive Wing HMM",
      "before": "Cartesian product of two independent Wing HMMs"
    },
    "token_count": {
      "after": 2,
      "before": 4
    }
  },
  "checkpoint_schedule": "initial, powers of two iterations, final",
  "clip_param": 0.2,
  "condition": "ppo",
  "context_semantics": "strict last 32 delayed token frames including current",
  "controls": [
    "train-mean belief predictor",
    "current-visible-token belief predictor",
    "shuffled-label affine probe"
  ],
  "entropy_coeff": 0.0,
  "environment": {
    "delay": 1,
    "episode_length": 1024,
    "model": {
      "factory": "envs.wing.model:wing_model",
      "kwargs": {
        "alpha": 0.94,
        "x": 0.4
      }
    },
    "observation": {
      "action": null,
      "token": {
        "depth": 1
      }
    },
    "randomize_first_episode_length": true,
    "task": {
      "class": "experiments.wing_token_guess_cycle_2.task:WingTokenGuessTask"
    }
  },
  "gamma": 0.0,
  "hypothesis": "PPO can learn the finite-context predictor for the pending single-HMM Wing token from delayed token history.",
  "intended_hardware": "CPU smoke; hardware-profile learner device for full training",
  "lambda": 0.0,
  "learning_rate": 0.0001,
  "minibatch_size": 4096,
  "model": {
    "activation": "relu",
